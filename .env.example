# 复制为 .env 并填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 排除，切勿提交真实密钥。
#
# ⚠️ 两侧代码都**不自动加载** .env（没有引入 dotenv）—— 它们直接读进程环境变量。
#    让 .env 生效：`set -a; source .env; set +a`（bash/zsh），或逐项 `export`
#    （见 docs/web-reverse/session-runbook.md §1）。仅创建 .env 文件是**不会**生效的。
#
# ⚠️ 变量名以**代码实际读取的**为准。本模板此前有三个名字写错的项
#    （AVM_COOKIE_FILE / AVM_PORT / 重复定义的 AVM_GATE_KEY——最后这个现已**废弃**：
#    鉴权收成了下面的单变量 AVM_AUTH），共同后果都是
#    **不报错、静默不生效**。核对方法：直接 grep 代码里的 os.environ / process.env。

# Base URL（一般无需修改）
AVM_BASE_URL=https://aivideomaker.ai

# --------------------------------------------------------------------------
# 上游凭据（网页端登录会话）
# ⚠️ **生产路径是 `src/ark_compat/`**（Ark 协议兼容层），它只认 `AVM_COOKIE`；
#    `src/web-adapter/` 是最初的逆向参考实现，**已不再部署** —— 下文标
#    「仅 web-adapter」的项只在跑那个目录时才有意义。
# --------------------------------------------------------------------------
# 从浏览器 cookie 导出（Cookie-Editor / EditThisCookie 的 export 格式，
# 或直接复制 auth_session 的值），TTL 400 天，不做滚动续期。
AVM_COOKIE=auth_session=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ⚠️ **仅 web-adapter**（生产路径不读它）：浏览器导出的 cookie jar 文件路径。
#    只写它却跑 ark_compat ⇒ 凭据根本不会被读到，表现为"没配上游" —— 属本文件
#    顶部警告的"不报错、静默不生效"那一类，故从注释里提出来就地标注。
#    变量名**不是** AVM_COOKIE_FILE（写后者同样静默失效）。
COOKIES_FILE=

# 访客标识（任意 32 位十六进制）。服务端**不校验**该值，但会写进 User.visitorId。
# 留空则用内置默认值 —— 注意那是**全项目共用的固定值**：多账号场景建议各自设置，
# 否则所有账号在服务端看来是同一个“访客”。生成一个：
#   python3 -c "import secrets;print(secrets.token_hex(16))"
AVM_VISITOR_ID=

# 用户 ID（可选）。留空时由 auth.user 自动解析，通常无需填写。
AVM_USER_ID=

# ⚠️ **仅 web-adapter**：PORT 只被 adapter.mjs 读取；生产路径的端口是 ARK_PORT（见下）。
#    变量名不是 AVM_PORT —— 写成后者不报错，只是静默不生效。
PORT=8788

# 上游并发上限（premium 套餐为 2）与队列重试策略（可选）
# ⚠️ 0 = 按**账号额度**自动（建上游时读 ai.queryUserPermission.maxQueueLength：
#    premium 2 / pro 4；读不到回落 2）。写死 2 会让 pro 的 4 并发用不满。
AVM_MAX_CONCURRENT=2
AVM_QUEUE_MAX_ATTEMPTS=8
# 是否把验证码闸门也当作“稍后重试”（默认关闭：等待可能数分钟且之后会真计费）
AVM_RETRY_CAPTCHA=0

# --------------------------------------------------------------------------
# 火山方舟兼容层（src/ark_compat/）：把 aivideomaker 包成 Ark Seedance 协议
# --------------------------------------------------------------------------
# 端口刻意与 web-adapter 分开：这里用 ARK_PORT（默认 8808），避免与 8788 撞变量。
# 启动：python3 src/ark_server.py
# 把火山 SDK 的 base_url 指向 http://127.0.0.1:8808/api/v3
#
# 上游只有一条：网页端内部接口（web 线）。凭据就是上面的 AVM_COOKIE。
# 免费窗口：tier=turbo 且 duration ≤10s。⚠️ 站点**没有取消端点** —— 删除只删本地记录。
# 并发闸门复用上面的 AVM_MAX_CONCURRENT（premium 2 / pro 4；0=按账号额度自动）。
AVM_POLL_SECONDS=10

# ---- 服务自身 ----
ARK_HOST=127.0.0.1
ARK_PORT=8808
# 服务名。默认值**只在 src/ark_compat/__init__.py 定义一处**，通常留空即可
# （空串按"未设置"处理，回落默认值 —— 见 settings.from_env）。
AVM_SERVICE_NAME=
# 部署环境标识，随遥测上报（如 production / staging）。留空 = 不标注。
AVM_ENVIRONMENT=

# ---- 鉴权：**一个变量**，三选一（默认留空）----
#   留空 / open   不校验（本机自用）；上游凭据取上面的 AVM_COOKIE
#   passthrough   透传（多租户）：请求的 Bearer **就是上游网页会话 cookie**
#                 （裸 token 或完整 Cookie 串都行），本进程不再需要 AVM_COOKIE
#   key:<密钥>    闸门：请求须带 `Authorization: Bearer <密钥>`
# ⚠️ 三态天然互斥 —— 同一个 Bearer 不可能既是闸门密钥又是上游凭据。以前这是两个变量
#    （闸门密钥 + 透传开关），同设必然让每个请求 401；现在那种组合**无法表达**。
# ⚠️ 只认上面三种写法：裸密钥不算闸门（必须写 `key:` 前缀，否则与模式名分不开）。
#    写错一律**拒绝启动**并列出可选写法 —— 不猜意图（猜错的代价是闸门静默消失）。
# ⚠️ 旧变量 AVM_GATE_KEY / AVM_PASSTHROUGH_COOKIE **已废弃**：只要它们还有行为
#    （闸门非空 / 透传为真），启动就会被拒绝并打印迁移映射（刻意不静默放过）。
AVM_AUTH=

# 本机/回环上游自测时置 1，绕开 HTTP_PROXY 与 macOS scutil 代理
AVM_NO_TRUST_ENV=0

# 号池上报：每 N 秒把**每个凭据**的余额 / 闸门状态作为 Logfire 指标上报
# 只读探测：credits.getCredits / model.needsCaptcha，不创建任务、不计费）。0 = 关闭。
# ⚠️ 采集与出口**解耦**：Logfire 未装配或出口不通时**照样采样**
#    （否则出口坏掉的那一刻反而彻底瞎掉），只是指标不可用。
# 指标：avm.account.credits / captcha_required / reachable，标签只用**凭据指纹**。
# ⚠️ 多 worker 会各报一份（指标带 pid 便于分辨）。
AVM_ACCOUNT_REPORT_SECONDS=300

# 探测类只读请求（model.needsCaptcha / credits.getCredits）的超时（秒）。
# 出口代理的 TLS 握手会抖动到 10s+，探测用短超时才能让重试循环保持节奏；
# 只读请求失败会**立即**重试 2 次（写入绝不自动重试 —— 没有幂等键）。
AVM_PROBE_TIMEOUT=8

# 号池上报是否带上账号身份（邮箱）。默认 0 = 不带（遥测里放 PII 要显式点头）。
# 打开后 avm.account.* 指标会多一个 identity 标签，便于把指标对回具体账号。
AVM_ACCOUNT_REPORT_IDENTITY=0

# Turnstile token 铸造服务（tools/turnstile_service.py，常驻 Xvfb 有头 Chrome）。
# 配上之后：闸门开启且调用方没带 token 时，会自动去取一个（吞吐 20 → ~120 条/小时）；
# 留空 = 不启用。⚠️ 该服务能产出"绕过风控的凭证"：默认开放（见下）**不等于**可以暴露公网。
# 支持逗号分隔**多实例**（如 http://host.docker.internal:8899,http://host.docker.internal:8890）：
# 适配层轮询分摊 + 故障转移 —— 账号多（≥10 个满负荷 pro）时单实例产能 ~0.35 token/s 不够用。
# 🔴 跑 compose 时**铸造能力默认开启**（生产默认需要：闸门开启时没 token 的提交吞吐约
# 20 条/小时，有铸造约 120 条/小时）。compose 用 `:-` 插值 ⇒ **这里留空 = 用兜底地址**
# http://host.docker.internal:8899（minter 走 host 网络，即监听宿主 8899），
# **别把留空理解成"关掉能力"**；确实不要铸造就只起适配层：`docker compose up -d ark-compat`。
AVM_MINTER_URL=
# 🔓 **跑 compose 时不需要这一项**（2026-09-14 定）：铸造服务默认开放，默认参数直接能跑。
# 但代价要知道 —— minter 走 host 网络 ⇒ 8899 即宿主端口，无凭据 = 谁连得上谁就能领 token
# （等于把过闸能力分发出去）。收口二选一：
#   ① 用 AVM_MINTER_BIND_HOST 把绑定收到回环/内网（compose 专属变量，见下）；
#   ② 在这里填一个随机串，**并把 AVM_MINTER_ALLOW_INSECURE 置 0** —— 此时缺 key 会让
#      `docker compose up` 直接失败（fail-closed 机制仍在，只是默认不启用）。
# **必须与 minter 侧的 MINTER_KEY 成对相等**：compose 里两侧同源于本变量（天然一致）；
# 手工接线时最容易只改一边 ⇒ minter 一律 401，适配层取不到 token（会如实报错，不静默提交）。
#
# `AVM_MINTER_ALLOW_INSECURE` 是**compose 专属变量**（故意不写进本模板：本文件只放代码实际
# 读取的变量，有 tests/test_env_template.py 双向把关），需要时直接写进你的 .env。
# 默认 1 = 开放（见上）；置 0 即恢复 fail-closed，要求同时配好上面那把 key。
AVM_MINTER_KEY=
AVM_MINTER_TIMEOUT=25
# 🔴 `AVM_MINTER_TZ`（compose 专属变量，默认 Asia/Shanghai）：**不是可选的美化项**。
# 缺它时容器按 UTC 跑，CF 会判定「时区/会话不一致」并下发**交互式挑战** ⇒ **铸造恒失败**
# （E2E-AVM-006 单变量实验定案：补上 TZ 后热卷首铸 2.96s、全新冷卷 5.20s，各 4/4 成功）。
# 除非确有理由要指定别的时区，否则**不要动它，更不要把 compose 里那一行删掉**；
# 部署前 `python3 tools/compose_wiring_check.py --resolve` 会拦住它丢失或留空。

# 日志与可观测性
AVM_LOG_LEVEL=INFO
AVM_LOGFIRE_SEND=if-token-present   # 未设 LOGFIRE_TOKEN 时不会外发任何数据
AVM_DISABLE_LOGFIRE=0
AVM_LOGFIRE_CONSOLE=0
# 脱敏默认关：上游的 request/response 原文直接进 trace（打开后含 session/cookie/
# api_key 字样的属性值会被整条替换成 [Scrubbed …]）
AVM_LOGFIRE_SCRUBBING=0
# 抓请求头要显式打开 —— 打开即 cookie 明文进 trace，只在自控项目里这么干
AVM_LOGFIRE_CAPTURE_HEADERS=0
# 单个属性值里字符串的截断上限（防 data URI 撑爆 trace，不是脱敏）
AVM_LOGFIRE_MAX_CHARS=20000
LOGFIRE_TOKEN=

# --------------------------------------------------------------------------
# 容器化（Dockerfile / docker-compose.yml）与 gunicorn 高可用
# --------------------------------------------------------------------------
# 任务表持久化后端。sqlite（默认）跨重启可读；memory 是**显式**测试开关
# （写错直接抛错，不会静默退化成内存）。容器里 AVM_TASK_DB 被固定为
# /data/.ark-tasks.db（挂卷），这里主要供本机直接跑时使用。
AVM_TASK_STORE=sqlite
AVM_TASK_DB=.ark-tasks.db
AVM_TASK_RETENTION_DAYS=7

# GET /tasks/{id} 的上游视图缓存 TTL（秒），轮询节流（避免把上游打到 429）。
# 非终态视图在 TTL 内直接回缓存；任务进终态（succeeded/failed/cancelled）后
# 视图不可变，**永久**缓存到记录被删。任务出片要 ~60s，默认 15s 足够。
# 0 = 显式关闭（每次都实时回上游）。⚠️ 透传部署下 sqlite 任务库从此存有
# 会话凭据（凭据绑定，E2E-AVM-011）：文件权限已自动收到 0600，请勿外发该文件。
AVM_TASK_CACHE_TTL=15

# gunicorn worker 数。⚠️ **默认必须是 1**：
#   上游闸门是**进程内** threading.Semaphore（src/ark_compat/web_queue.py），
#   "全局只跑 2 个任务"这个保证依赖单进程。开 N 个 worker 会让实际并发变成 N×2，
#   第 3 个起上游直接报 "The queue is full"（并更易触发 Turnstile）。
#   安全的多 worker 组合：workers ≤ AVM_MAX_CONCURRENT 时，src/gunicorn_conf.py 会把
#   全局额度按 worker 数**向下分摊**并打印实际全局值 —— 例如 2÷2 ⇒ 每 worker 1、
#   实际全局仍是 2，既拿到 worker 级故障隔离又没超上游限制。
AVM_WORKERS=1

# ⚠️ **内部注入，不要手工设置**：`AVM_MAX_CONCURRENT=0`（自动）且 workers>1 时，
#    gunicorn master 会把它置为 worker 数，worker 内据此把探测到的账号额度向下分摊
#    （pro 4 ÷ 2 ⇒ 每 worker 2，**每账号全局仍恰好 4**）。手工设成别的值会让全局
#    并发偏离上游额度：设 1 ⇒ 退化成不按账号额度；设大 ⇒ 撞上游 "queue is full"。
AVM_CONCURRENCY_DIVISOR=1

# gunicorn worker 超时（秒）。必须**远大于**闸门等待上限 600s ——
# WebSubmitQueue.acquire_timeout 硬编码 600s 且未暴露为变量，因此一个提交请求
# 合法地可以阻塞 10 分钟等空槽；沿用 gunicorn 默认的 30s 会在 30 秒时把 worker
# 当卡死杀掉（表现为随机 502，且极难归因）。默认 660 = 600 + 余量。
AVM_GUNICORN_TIMEOUT=660
# 收到 SIGTERM 后在途请求的收尾窗口。要与容器 stop_grace_period 一起看，
# 否则容器会先 SIGKILL、gunicorn 来不及优雅退出。
AVM_GUNICORN_GRACEFUL_TIMEOUT=30
AVM_GUNICORN_LOGLEVEL=info

# gunicorn 其余可调项（默认值即 gunicorn 自身默认，一般无需设置）
AVM_GUNICORN_KEEPALIVE=5
AVM_GUNICORN_BACKLOG=2048
AVM_GUNICORN_WORKER_CONNECTIONS=1000
# 每 worker 处理 N 个请求后重启（0=不重启），用于缓慢内存泄漏兜底；jitter 为抖动上限。
AVM_GUNICORN_MAX_REQUESTS=0
AVM_GUNICORN_MAX_REQUESTS_JITTER=0
# 反向代理之后**必须**放宽：默认只信任 127.0.0.1 发来的 X-Forwarded-*。
# 反代源 IP 不是回环（如容器网关）却不设它 ⇒ 记到的客户端地址是反代地址。
AVM_GUNICORN_FORWARDED_IPS=
# 看门狗探活改用外部 URL（默认探本地 /healthz）。留空即用内置探活。
AVM_GUNICORN_WATCHDOG_URL=

# 存活看门狗（默认 0=关）。打开后连续 N 次本地 /healthz 失败即令 master 退出，
# 交给容器 restart 策略重建。Docker 的 HEALTHCHECK 本身**不会**重启容器，
# 所以这是唯一能覆盖"master 活着但 worker 全部僵死"的手段。
# 误判会造成重启循环，故默认关闭。
AVM_GUNICORN_WATCHDOG=0
AVM_GUNICORN_WATCHDOG_FAILURES=5
AVM_GUNICORN_WATCHDOG_INTERVAL=30

# 注：compose 专属的那几个变量（AVM_IMAGE_TAG 镜像 tag、AVM_HOST_PORT 宿主侧端口、
#     AVM_MINTER_ALLOW_INSECURE / AVM_MINTER_BIND_HOST / AVM_MINTER_POOL / AVM_MINTER_TTL、
#     AVM_MINTER_TZ 铸造容器时区、AVM_MINTER_RENDER_TIMEOUT_MS /
#     AVM_MINTER_COLD_RENDER_TIMEOUT_MS）**故意不在此声明**
#     —— 完整清单与各自含义见 docker-compose.yml 文件头。
#     本模板的门禁（tests/test_env_template.py）是**双向**的：
#       ① 声明了却不被代码读取 → 判失败（"照着配也不生效、而且不报错"的高发区，
#          本文件顶部记录的三个历史错名就是这类）；
#       ② 生产代码读取了却未在此声明 → 同样判失败（反向漏登记：运维照模板配 .env
#          时根本不知道有这个开关 —— AVM_CONCURRENCY_DIVISOR 就是这么被漏掉的）。
#     上面那些只被 docker-compose.yml 的变量插值使用（不经代码读取，故不受上面两条约束），
#     需要时直接写进你的 .env 即可（compose 会读），但不要加回本模板。
