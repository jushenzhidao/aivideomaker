# Turnstile 铸造服务镜像（tools/turnstile_service.py）
#
# 为什么**单独一个镜像**：它要装 Google Chrome + Xvfb（约 500MB），而适配层镜像
# 是 python:3.12-slim 的瘦身版 —— 混在一起会让每次改业务代码都重下 Chrome。
#
# 为什么必须 **Xvfb（有头）而不是 --headless**：实测同一台机器、同一 Chrome 版本、
# 同出口 IP，`--headless=new` **0/4 全部 46 秒超时**，`xvfb-run` 有头 **8/8、3.7 秒/个**。
# 详见 tools/turnstile_minter.py 顶部的实测表。
#
# 安全：该服务能产出"绕过风控的凭证"。**不要映射端口到宿主**，只让同 compose 网络里的
# ark-compat 用。
# 🔴 **MINTER_KEY 是必设项，不是可选项**：本镜像里 BIND_HOST=0.0.0.0（非回环），
#    而未设 MINTER_KEY 时服务会**拒绝启动**（退出码 2，fail-closed）—— 容器表现为
#    restart 循环，日志里写明原因与三条出路。这是刻意的取舍：宁可起不来，也不把
#    "过闸能力"匿名挂在公网端口上。仅私有网络可用 MINTER_ALLOW_INSECURE=1 显式放行。
#    （2026-09-14 发版流水线正是因此变红：那时冒烟没带 key —— 守卫按设计生效，镜像没坏。）

# ⚠️ 必须钉 **bookworm**：`python:3.12-slim` 现在基于 Debian 13(trixie)，而 Chrome 的 deb
# 依赖 `libasound2` —— 该包在 trixie 里改名为 `libasound2t64` ⇒ apt 直接以 exit 100 失败
# （实测踩到：构建卡在装 Chrome 那一步，日志只给一句 "did not complete successfully"）。
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8899 \
    BIND_HOST=0.0.0.0 \
    CDP_PORT=9222 \
    CHROME_PROFILE=/data/chrome \
    POOL_TARGET=4 \
    TOKEN_TTL_S=120 \
    TZ=Asia/Shanghai

# ★ `TZ` 是**铸造能否成功的前提，不是可选的美化项**（E2E-AVM-006 定案）：
#   容器默认 UTC 时 CF 会判定"时区/会话不一致"并下发**交互式挑战** ⇒ 铸造恒失败
#   （现象是 `interactive` 分类、每次约 12s 快速失败、0 token；冷/热 profile 都一样）。
#   同一台机器上补上 TZ=Asia/Shanghai 后：热卷首铸 2.96s、全新冷卷首铸 5.20s，各铸 4/4。
#   ⚠️ 与部署机 compose 的 `AVM_MINTER_TZ` **同一个语义、同一个默认值**（两边都设是为了让
#      "手工 docker run 本镜像"与"compose 起服务"拿到一致的环境，不设 compose 也正确）。
#   ⚠️ 2026-09-14 曾有一版 TZ 改动被还原，理由是在 macOS Docker Desktop 上四格实验证伪 ——
#      那台机器的结论没错（host 网络在 Mac 上仍经 VPNkit NAT，Mac 本就该宿主机直跑）；
#      本条的结论来自 Linux 原生 Docker + host 网络上的干净单变量实验。别再把两者混为一谈。

# 额外装的几组（都有理由，不是"顺手多加"）：
#   * xauth      —— 没有它 `xvfb-run` 直接起不来（容器里实测踩到，且补货线程会被
#                   SystemExit 静默打死 ⇒ ready=false / last_error=null，极难查）；
#   * 多字体      —— 只装 liberation 时字体家族只有 4 个，而真人浏览器有几十个，
#                   这是容器里最容易被 CF 当机器人的信号之一；
#   * libgl1/mesa —— CF 会查 WebGL 渲染器，缺库时报"无 WebGL" ⇒ 强负信号。
#   * tzdata     —— 让 `TZ=Asia/Shanghai` 在 **libc 层**也真的生效（`/usr/share/zoneinfo`
#                   缺失时 `TZ` 会被 libc 静默当成 UTC：变量看起来设了，`date` 却是 UTC）。
#                   ⚠️ 它不是"铸造能不能成"的决定因素 —— Chrome 走自带的 ICU 时区库，
#                   E2E-AVM-006 那组决定性实验就是在**没有**本包的镜像上跑通的。装它是为了
#                   不让 `TZ` 变成"只对浏览器生效、对系统半生效"的半吊子配置
#                   （本项目最忌讳的那类"配了像没配"）。
# ⚠️ 这些注释**不能写在 RUN 的续行里面**：Dockerfile 只在行首识别注释，续行里的 `#`
#    会被 shell 当注释，把后半行命令（含 `&& curl ... install chrome`）整段吃掉，
#    而该层还会"成功"—— 典型的静默破坏。
#
# Chrome 运行库 + Xvfb，**与装 Chrome 合成一层**。
#
# ⚠️ 为什么不能拆成两个 RUN：拆开时若在前一层结尾清理了 `/var/lib/apt/lists/*`，
# 后一层装 deb 就会因为**没有 apt 索引**而报
#   `google-chrome-stable : Depends: libvulkan1 but it is not installable`
# （libvulkan1 / wget / xdg-utils 全"不可安装"，exit code 100）。实测踩过。
#
# 注：Docker 的 linter 会就 `ENV TOKEN_TTL_S` 报 SecretsUsedInArgOrEnv —— 名字里有 "TOKEN"
# 触发的误报（它是**存活秒数**，不是密钥），仅是 warning。
# ⚠️ **多架构**：Google 不发布 Linux/arm64 的 Chrome，而本机（Apple Silicon）+ 任何
# arm64 主机都必须走原生 arm64 —— 若用 `--platform linux/amd64` 让 Chrome 跑在
# Rosetta/QEMU 模拟层里，CF 挑战的 JS 计时/行为信号会明显异常（等于把"我是模拟器"
# 写在脸上）。所以：amd64 用 Google Chrome 官方 deb；arm64 用 Debian 原生 chromium
# （bookworm-security 的 152.x 与 Chrome 153 同代，不算旧）。二进制路径由
# turnstile_minter.chrome_bin() 自动发现（google-chrome → chromium）。
ARG TARGETARCH
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && printf 'Acquire::Retries "6";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' \
        > /etc/apt/apt.conf.d/80avm-retries \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl xvfb xauth dbus dbus-x11 tzdata \
        fonts-liberation fonts-dejavu-core fonts-noto-core fonts-noto-color-emoji \
        libgl1 libglx-mesa0 libegl1 \
        libnss3 libxss1 libatk-bridge2.0-0 libatk1.0-0 libgtk-3-0 libgbm1 libasound2 \
        libx11-xcb1 libxcomposite1 libxdamage1 libxrandr2 libxkbcommon0 \
        libpango-1.0-0 libcairo2 \
    && if [ "$TARGETARCH" = "arm64" ]; then \
        apt-get install -y --no-install-recommends chromium; \
    else \
        curl -fsSL -o /tmp/chrome.deb \
            https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
        && apt-get install -y /tmp/chrome.deb \
        && rm -f /tmp/chrome.deb; \
    fi \
    && rm -rf /var/lib/apt/lists/*

# CDP 客户端（服务用原生 CDP，不依赖 Playwright：少一层、也少一个浏览器下载）
RUN pip install --no-cache-dir websocket-client

WORKDIR /app
COPY tools/turnstile_minter.py tools/turnstile_service.py /app/tools/

# Chrome 的 profile 落在卷里：① 重启后不用重新冷启动 ② 画像有点"年龄"总比每次全新好
# ⚠️ 实测复盘（E2E-AVM-004 → E2E-AVM-006）：
#    * 全新 profile 的**首铸**曾在新部署上**卡死**而非"慢"—— 120s 冷预算也不出 token；
#      旧注释里的「首次 render ~46 秒」是 45s 超时签名的误读，已证伪，别再改回去。
#    * **根因（E2E-AVM-006 定案）= 环境缺 `TZ`**，不是 profile 冷热、也不是核心版本：
#      补上 TZ 后全新冷卷首铸 5.20s（4/4 成功），而缺 TZ 时热卷也照样 interactive ×3。
#    * ❌ 因此旧注释里「用长期实例的热 profile 播种 /data 卷」这条建议**已被实验否掉**
#      （AVM16-SEED-HOT：整卷播种后 3 连败全 interactive，CF 的信任不落在 profile 里）。
#      —— 别再据此把 /data 卷当成解药；要的是 `TZ` 在场。播种的唯一价值是省掉预热时间。
VOLUME ["/data"]
EXPOSE 8899

# start-period 给足：首次冷启动 + 池子补满约 1 分钟
HEALTHCHECK --interval=30s --timeout=5s --start-period=150s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:8899/healthz" >/dev/null || exit 1

CMD ["python3", "/app/tools/turnstile_service.py"]
