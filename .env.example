# 复制为 .env 并填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 排除，切勿提交真实密钥。
#
# ⚠️ 两侧代码都**不自动加载** .env（没有引入 dotenv）—— 它们直接读进程环境变量。
#    让 .env 生效：`set -a; source .env; set +a`（bash/zsh），或逐项 `export`
#    （见 docs/web-reverse/session-runbook.md §1）。仅创建 .env 文件是**不会**生效的。
#
# ⚠️ 变量名以**代码实际读取的**为准。本模板此前有三个名字写错的项
#    （AVM_COOKIE_FILE / AVM_PORT / 重复定义的 AVM_GATE_KEY），共同后果都是
#    **不报错、静默不生效**。核对方法：直接 grep 代码里的 os.environ / process.env。

# aivideomaker.ai API Key（在 https://aivideomaker.ai/zh/app/settings/account/api-keys 创建）
AVM_KEY=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL（一般无需修改）
AVM_BASE_URL=https://aivideomaker.ai

# --------------------------------------------------------------------------
# web 逆向线（src/web-adapter/）：网页端登录会话
# --------------------------------------------------------------------------
# 从浏览器 cookie 导出（Cookie-Editor / EditThisCookie 的 export 格式，
# 或直接复制 auth_session 的值），TTL 400 天，不做滚动续期。
# 格式二选一：
#   AVM_COOKIE=auth_session=<40位随机串>; NEXT_LOCALE=zh
#   COOKIES_FILE=./cookies.json            # 浏览器导出的 cookie jar
# ⚠️ 变量名是 COOKIES_FILE（adapter.mjs / session-diagnose.mjs 读的就是它），
#    **不是** AVM_COOKIE_FILE —— 写成后者不会报错，只是静默不生效。
AVM_COOKIE=auth_session=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 访客标识（任意 32 位十六进制）。服务端**不校验**该值，但会写进 User.visitorId。
# 留空则用内置默认值 —— 注意那是**全项目共用的固定值**：多账号场景建议各自设置，
# 否则所有账号在服务端看来是同一个“访客”。生成一个：
#   python3 -c "import secrets;print(secrets.token_hex(16))"
AVM_VISITOR_ID=

# 用户 ID（可选）。留空时由 auth.user 自动解析，通常无需填写。
AVM_USER_ID=

# 适配层监听端口。⚠️ 代码读的是 PORT（adapter.mjs），**不是** AVM_PORT。
PORT=8788

# 上游并发上限（premium 套餐为 2）与队列重试策略（可选）
AVM_MAX_CONCURRENT=2
AVM_QUEUE_MAX_ATTEMPTS=8
# 是否把验证码闸门也当作“稍后重试”（默认关闭：等待可能数分钟且之后会真计费）
AVM_RETRY_CAPTCHA=0

# --------------------------------------------------------------------------
# 火山方舟兼容层（src/ark_compat/）：把 aivideomaker 包成 Ark Seedance 协议
# --------------------------------------------------------------------------
# 端口刻意与 web-adapter 分开：这里用 ARK_PORT（默认 8808），避免与 8788 撞变量。
# 启动：python3 src/ark_server.py
# 把火山 SDK 的 base_url 指向 http://127.0.0.1:8808/api/v3

# ---- 两条上游：都配齐就都能用，不是二选一 ----
# 默认走哪条；按请求可用 `X-Avm-Upstream: web|official` 或 `?upstream=` 覆盖
AVM_UPSTREAM=official

# 官方线凭据（要与官方线上游配合使用；AVM_KEY 已在文件顶部声明）
#   官方线：提交即计费，无免费窗口，可取消并全额退积分

# web 线凭据（网页端会话 cookie）：有免费窗口（turbo ≤8s），但**没有取消端点**
# 从浏览器 cookie 导出，TTL 约 400 天，不做滚动续期
# AVM_COOKIE=auth_session=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# web 线并发闸门复用上面的 AVM_MAX_CONCURRENT（上游 premium 只跑 2 个）
AVM_POLL_SECONDS=10

# ---- 服务自身 ----
ARK_HOST=127.0.0.1
ARK_PORT=8808

# 网关密钥：web-adapter 与 ark_compat **共用**这一个变量
#   - web-adapter：设了则 /v1/* 要求 `Authorization: Bearer <it>`
#   - ark_compat：设了则启用闸门鉴权
# ⚠️ 只在这一处定义。同一个 .env 里写两条，后写的会**静默覆盖**前一条 ——
#    这正是本模板此前的实际状态（一条 sk-avm-demo + 一条空值 ⇒ 生效的是空值）。
# 留空 = 不校验（仅限本机自用）。
AVM_GATE_KEY=sk-avm-demo

# ⚠️ 官方线“提交即计费”，没有 web 线的免费窗口。这里设全局支出上限；
# 不设则每个请求必须自带 extra_body.aivideomaker_max_credits，否则一律 400 拒绝。
# 该值会作为 X-Max-Credits 传给上游，超限在计费前被拒。
AVM_OFFICIAL_MAX_CREDITS=

# 默认官方模型。留空则按 model 名推断（doubao-seedance-* → seedance20）。
AVM_OFFICIAL_MODEL=

# 透传模式：把调用方携带的 Bearer token 直接当上游 key（省去两套 key）
AVM_PASSTHROUGH_KEY=0

# 本机/回环上游自测时置 1，绕开 HTTP_PROXY 与 macOS scutil 代理
AVM_NO_TRUST_ENV=0

# 日志与可观测性
AVM_LOG_LEVEL=INFO
AVM_LOGFIRE_SEND=if-token-present   # 未设 LOGFIRE_TOKEN 时不会外发任何数据
AVM_DISABLE_LOGFIRE=0
AVM_LOGFIRE_CONSOLE=0
# 脱敏默认关：上游的 request/response 原文直接进 trace（打开后含 session/cookie/
# api_key 字样的属性值会被整条替换成 [Scrubbed …]）
AVM_LOGFIRE_SCRUBBING=0
# 抓请求头要显式打开 —— 打开即 key / cookie 明文进 trace，只在自控项目里这么干
AVM_LOGFIRE_CAPTURE_HEADERS=0
# 单个属性值里字符串的截断上限（防 data URI 撑爆 trace，不是脱敏）
AVM_LOGFIRE_MAX_CHARS=20000
LOGFIRE_TOKEN=
