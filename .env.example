# 复制为 .env 并填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 排除，切勿提交真实密钥。
#
# ⚠️ 两侧代码都**不自动加载** .env（没有引入 dotenv）—— 它们直接读进程环境变量。
#    让 .env 生效：`set -a; source .env; set +a`（bash/zsh），或逐项 `export`
#    （见 docs/web-reverse/session-runbook.md §1）。仅创建 .env 文件是**不会**生效的。
#
# ⚠️ 变量名以**代码实际读取的**为准。本模板此前有三个名字写错的项
#    （AVM_COOKIE_FILE / AVM_PORT / 重复定义的 AVM_GATE_KEY），共同后果都是
#    **不报错、静默不生效**。核对方法：直接 grep 代码里的 os.environ / process.env。

# Base URL（一般无需修改）
AVM_BASE_URL=https://aivideomaker.ai

# --------------------------------------------------------------------------
# web 逆向线（src/web-adapter/）：网页端登录会话
# --------------------------------------------------------------------------
# 从浏览器 cookie 导出（Cookie-Editor / EditThisCookie 的 export 格式，
# 或直接复制 auth_session 的值），TTL 400 天，不做滚动续期。
# 格式二选一：
#   AVM_COOKIE=auth_session=<40位随机串>; NEXT_LOCALE=zh
#   COOKIES_FILE=./cookies.json            # 浏览器导出的 cookie jar
# ⚠️ 变量名是 COOKIES_FILE（adapter.mjs / session-diagnose.mjs 读的就是它），
#    **不是** AVM_COOKIE_FILE —— 写成后者不会报错，只是静默不生效。
AVM_COOKIE=auth_session=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 访客标识（任意 32 位十六进制）。服务端**不校验**该值，但会写进 User.visitorId。
# 留空则用内置默认值 —— 注意那是**全项目共用的固定值**：多账号场景建议各自设置，
# 否则所有账号在服务端看来是同一个“访客”。生成一个：
#   python3 -c "import secrets;print(secrets.token_hex(16))"
AVM_VISITOR_ID=

# 用户 ID（可选）。留空时由 auth.user 自动解析，通常无需填写。
AVM_USER_ID=

# 适配层监听端口。⚠️ 代码读的是 PORT（adapter.mjs），**不是** AVM_PORT。
PORT=8788

# 上游并发上限（premium 套餐为 2）与队列重试策略（可选）
AVM_MAX_CONCURRENT=2
AVM_QUEUE_MAX_ATTEMPTS=8
# 是否把验证码闸门也当作“稍后重试”（默认关闭：等待可能数分钟且之后会真计费）
AVM_RETRY_CAPTCHA=0

# --------------------------------------------------------------------------
# 火山方舟兼容层（src/ark_compat/）：把 aivideomaker 包成 Ark Seedance 协议
# --------------------------------------------------------------------------
# 端口刻意与 web-adapter 分开：这里用 ARK_PORT（默认 8808），避免与 8788 撞变量。
# 启动：python3 src/ark_server.py
# 把火山 SDK 的 base_url 指向 http://127.0.0.1:8808/api/v3
#
# 上游只有一条：网页端内部接口（web 线）。凭据就是上面的 AVM_COOKIE。
# 免费窗口：tier=turbo 且 duration ≤8s。⚠️ 站点**没有取消端点** —— 删除只删本地记录。
# 并发闸门复用上面的 AVM_MAX_CONCURRENT（上游 premium 只跑 2 个）。
AVM_POLL_SECONDS=10

# ---- 服务自身 ----
ARK_HOST=127.0.0.1
ARK_PORT=8808

# 网关密钥：web-adapter 与 ark_compat **共用**这一个变量
#   - web-adapter：设了则 /v1/* 要求 `Authorization: Bearer <it>`
#   - ark_compat：设了则启用闸门鉴权
# ⚠️ 只在这一处定义。同一个 .env 里写两条，后写的会**静默覆盖**前一条 ——
#    这正是本模板此前的实际状态（一条 sk-avm-demo + 一条空值 ⇒ 生效的是空值）。
# 留空 = 不校验（仅限本机自用）。
AVM_GATE_KEY=sk-avm-demo

# 透传模式：调用方的 `Authorization: Bearer` 就是**网页会话 cookie**
# （裸 token 或完整 Cookie 串都行），本进程不再需要 AVM_COOKIE。多租户场景用它。
# ⚠️ 与 AVM_GATE_KEY **互斥** —— 同一个 Bearer 不可能既是闸门密钥又是上游凭据，
#    两者同设会让每个请求都在闸门处 401，所以 Settings.validate() 直接拒绝启动。
AVM_PASSTHROUGH_COOKIE=0

# 本机/回环上游自测时置 1，绕开 HTTP_PROXY 与 macOS scutil 代理
AVM_NO_TRUST_ENV=0

# 号池上报：每 N 秒把**每个凭据**的余额 / 闸门状态作为 Logfire 指标上报
# （只读探测：credits.getCredits / GET /api/v1/account / model.needsCaptcha，
# 不创建任务、不计费）。0 = 关闭。Logfire 未装配时**不采样**（不会白打上游）。
# 指标：avm.account.credits / captcha_required / reachable，标签只用**凭据指纹**。
# ⚠️ 多 worker 会各报一份（指标带 pid 便于分辨）。
AVM_ACCOUNT_REPORT_SECONDS=300

# 探测类只读请求（model.needsCaptcha / credits.getCredits）的超时（秒）。
# 出口代理的 TLS 握手会抖动到 10s+，探测用短超时才能让重试循环保持节奏；
# 只读请求失败会**立即**重试 2 次（写入绝不自动重试 —— 没有幂等键）。
AVM_PROBE_TIMEOUT=8

# 日志与可观测性
AVM_LOG_LEVEL=INFO
AVM_LOGFIRE_SEND=if-token-present   # 未设 LOGFIRE_TOKEN 时不会外发任何数据
AVM_DISABLE_LOGFIRE=0
AVM_LOGFIRE_CONSOLE=0
# 脱敏默认关：上游的 request/response 原文直接进 trace（打开后含 session/cookie/
# api_key 字样的属性值会被整条替换成 [Scrubbed …]）
AVM_LOGFIRE_SCRUBBING=0
# 抓请求头要显式打开 —— 打开即 cookie 明文进 trace，只在自控项目里这么干
AVM_LOGFIRE_CAPTURE_HEADERS=0
# 单个属性值里字符串的截断上限（防 data URI 撑爆 trace，不是脱敏）
AVM_LOGFIRE_MAX_CHARS=20000
LOGFIRE_TOKEN=

# --------------------------------------------------------------------------
# 容器化（Dockerfile / docker-compose.yml）与 gunicorn 高可用
# --------------------------------------------------------------------------
# 任务表持久化后端。sqlite（默认）跨重启可读；memory 是**显式**测试开关
# （写错直接抛错，不会静默退化成内存）。容器里 AVM_TASK_DB 被固定为
# /data/.ark-tasks.db（挂卷），这里主要供本机直接跑时使用。
AVM_TASK_STORE=sqlite
AVM_TASK_DB=.ark-tasks.db
AVM_TASK_RETENTION_DAYS=7

# gunicorn worker 数。⚠️ **默认必须是 1**：
#   上游闸门是**进程内** threading.Semaphore（src/ark_compat/web_queue.py），
#   "全局只跑 2 个任务"这个保证依赖单进程。开 N 个 worker 会让实际并发变成 N×2，
#   第 3 个起上游直接报 "The queue is full"（并更易触发 Turnstile）。
#   安全的多 worker 组合：workers ≤ AVM_MAX_CONCURRENT 时，src/gunicorn_conf.py 会把
#   全局额度按 worker 数**向下分摊**并打印实际全局值 —— 例如 2÷2 ⇒ 每 worker 1、
#   实际全局仍是 2，既拿到 worker 级故障隔离又没超上游限制。
AVM_WORKERS=1

# gunicorn worker 超时（秒）。必须**远大于**闸门等待上限 600s ——
# WebSubmitQueue.acquire_timeout 硬编码 600s 且未暴露为变量，因此一个提交请求
# 合法地可以阻塞 10 分钟等空槽；沿用 gunicorn 默认的 30s 会在 30 秒时把 worker
# 当卡死杀掉（表现为随机 502，且极难归因）。默认 660 = 600 + 余量。
AVM_GUNICORN_TIMEOUT=660
# 收到 SIGTERM 后在途请求的收尾窗口。要与容器 stop_grace_period 一起看，
# 否则容器会先 SIGKILL、gunicorn 来不及优雅退出。
AVM_GUNICORN_GRACEFUL_TIMEOUT=30
AVM_GUNICORN_LOGLEVEL=info

# 存活看门狗（默认 0=关）。打开后连续 N 次本地 /healthz 失败即令 master 退出，
# 交给容器 restart 策略重建。Docker 的 HEALTHCHECK 本身**不会**重启容器，
# 所以这是唯一能覆盖"master 活着但 worker 全部僵死"的手段。
# 误判会造成重启循环，故默认关闭。
AVM_GUNICORN_WATCHDOG=0
AVM_GUNICORN_WATCHDOG_FAILURES=5
AVM_GUNICORN_WATCHDOG_INTERVAL=30

# 注：compose 专用的两项（AVM_IMAGE_TAG 镜像 tag、AVM_HOST_PORT 宿主侧端口）**故意不在此声明**。
#     本模板有一道门禁（tests/test_env_template.py）：声明了却不被代码读取的变量会判失败 ——
#     那正是"照着配也不生效、而且不报错"的高发区（本文件顶部记录的三个历史错名就是这类）。
#     这两项只被 docker-compose.yml 的变量插值使用，需要时直接写进你的 .env 即可（compose 会读），
#     但不要加回本模板。
